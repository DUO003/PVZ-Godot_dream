extends Control
class_name 背包
var 背包页码 = 0
var 背包选中 = 1
var 背包展示数量 = 15
var 背包物品 = []
# 旋转速度：每秒旋转的弧度（正数顺时针，负数逆时针）
@export var 旋转速度: float = 2  # 可在 inspector 中调整

func _ready():
	
	# 所有物品名称的列表（从你的打印结果中提取）
	var all_items = [
		"金币", 
		"豌豆", 
		"寒冰豌豆", 
		"孢子", 
		"孢子气泡", 
		"火焰豌豆", 
		"尖刺", 
		"杨桃", 
		"卷心菜", 
		"玉米粒", 
		"黄油", 
		"西瓜", 
		"图鉴"
	]

	# 遍历所有物品，每个都获得一个
	for item_name in all_items:
		全局放置.获得物品(item_name, 1)
		print("已获得物品: ", item_name)

	print("所有物品测试添加完成")
	
	初始化背包格子()
	更新简介()

func _process(delta: float):
	# 每一帧更新旋转角度
	# delta 是上一帧到当前帧的时间间隔，确保不同帧率下旋转速度一致
	
	var 物品图片节点 = $"物品贴图"
	if 旋转速度 == 0:
		物品图片节点.rotation = 0
	else:
		物品图片节点.rotation += 旋转速度 * delta

func 初始化背包格子():
	背包物品 = 全局放置.读取物品数组()
	var 物品索引 = 0
	var 物品索引编号 = 0
	for 排号 in range(1, 4):
		for 物品栏号 in range(1, 6):
			var 物品栏路径 = "背包格子/排" + str(排号) + "/物品栏" + str(物品栏号)
			物品索引编号 += 1
			get_node(物品栏路径).按钮编号=物品索引编号
			if 物品索引 < 背包物品.size():
				var 物品的名称 = 背包物品[物品索引]
				设置物品栏(物品栏路径, 物品的名称)
				物品索引 += 1
			else:
				设置物品栏初始值(物品栏路径)
			

func 设置物品栏(物品栏路径: String, 物品名称: String):
	var 数量标签 = get_node(物品栏路径 + "/数量")
	var 名称标签 = get_node(物品栏路径 + "/名称")
	var 物品贴图 = get_node(物品栏路径 + "/物品图片")
	print(物品栏路径,"：",物品名称)
	print(str(全局放置.读取物品(物品名称)),"：",物品名称,"：",全局放置.加载物品贴图(物品名称))
# 安全检查
	if 数量标签 != null:
		数量标签.text = str(全局放置.读取物品(物品名称))  # 获取物品数量

	if 名称标签 != null:
		名称标签.text = 物品名称  # 使用数组中的名称

	if 物品贴图 != null:
		物品贴图.texture = 全局放置.加载物品贴图(物品名称)  # 获取物品贴图

func 设置物品栏初始值(物品栏路径: String):
	#print(物品栏路径)
	var 数量标签 = get_node(物品栏路径 + "/数量")
	var 名称标签 = get_node(物品栏路径 + "/名称")
	var 物品贴图 = get_node(物品栏路径 + "/物品图片")
	# 安全检查
	if 数量标签 != null:
		数量标签.text = ""
	if 名称标签 != null:
		名称标签.text = ""
	if 物品贴图 != null:
		#物品贴图.texture = 全局放置.加载物品贴图("金币")#金币
		物品贴图.texture = null#空


## 返回开始菜单
func _on_主菜单() -> void:
	get_tree().change_scene_to_file("res://FZB/场景/放置版主菜单.tscn")


func _物品点击(按钮编号) -> void:
	背包选中 = 按钮编号 + 背包页码 * 背包展示数量
	更新简介()

func 更新简介():
	var 物品名称节点 = $"物品名称"
	var 物品简介节点 = $"文本描述"
	var 物品图片节点 = $"物品贴图"
	var 索引 = 背包选中 - 1
	
	if 索引 >= 0 and 索引 < 背包物品.size():
		物品名称节点.text = str(背包物品[索引])
		var 原始简介 = 全局放置.加载物品简介(背包物品[索引])
		var 物品参数 = 全局放置.加载物品参数(背包物品[索引])
		var 最终简介 = 原始简介
		print("物品：",str(背包物品[索引]))
		print("参数：",物品参数)
		if 物品参数.has("精通值"):
			# 检查原始简介是否包含占位符
			if 原始简介.find("{精通值}") == -1:
				var 精通值文本 = "精通值：" + str(物品参数["精通值"]) + "\n"  # 换行
				# 无占位符，在开头添加精通值信息
				最终简介 = 精通值文本 + 原始简介
			else:
				# 有占位符，直接替换
				最终简介 = 原始简介.replace("{精通值}", str(物品参数["精通值"]))
		else:
			if 原始简介.find("{精通值}") == -1:
				最终简介 = 原始简介.replace("{精通值}", str(0))
		物品简介节点.text = str(最终简介)
		物品图片节点.texture = 全局放置.加载物品贴图(背包物品[索引])
		
		# 读取旋转调整参数，默认为2
		if 物品参数.has("旋转调整"):
			旋转速度 = 物品参数["旋转调整"]
		else:
			旋转速度 = 2  # 默认值
		
	else:
		print("索引",索引)
