extends Control

# 1. 奖池变量（键：植物名称，值：碎片数量），最多3种植物
var 奖池: Dictionary = {}
# 2. 关卡奖励卡池（示例数据，实际由关卡传递）
var 关卡奖励卡池: Array = 全局放置.关卡奖励卡池
# 首通奖励标记（由外部设置，例如关卡是否首次通关）
var 首通奖励: bool = 全局放置.首通奖励
# 碎片奖励抽取次数（由外部设置，例如关卡固定掉落3次）
var 碎片奖励次数: int = 全局放置.碎片奖励次数
var 关卡金币奖励 = 全局放置.关卡金币奖励

func _ready():
	# 测试：执行奖励抽取逻辑
	全局放置.处理通关记录()
	首通奖励 = 全局放置.首通奖励
	抽取植物碎片奖励()
	#print(奖池)
	var 植物奖励 = 奖池.keys()[0]
	加载植物简介(植物奖励)
	加载植物奖励()
	全局放置.获得物品("金币",关卡金币奖励)
	var 金币路径 = $"金币/金币数量"
	金币路径.text = "本局累积金币\r金币："+str(关卡金币奖励)
	

func 加载植物奖励():
	var 奖励列表 = 奖池.keys()
	
	for i in range(3):
		if i < 奖励列表.size():
			var 植物奖励 = 奖励列表[i]
			全局放置.增加植物碎片(str(植物奖励),奖池.get(str(植物奖励)))
			更新奖励(i)
		else:
			var 植物卡路径 = "碎片容器/植物卡"
			植物卡路径 =get_node(植物卡路径+str(i+1))
			植物卡路径.visible = false
		

func 更新奖励(i):
	var 植物奖励 = 奖池.keys()[i]
	var 植物卡路径 = "碎片容器/植物卡"
	var 植物场景容器 = get_node(植物卡路径 +str(i+1)+ "/植物场景")
	var 植物解锁按钮文本 = get_node(植物卡路径 +str(i+1)+ "/按钮/按钮文本")
	var 植物名称 = get_node(植物卡路径 +str(i+1)+ "/植物属性/植物名称")
	var 植物升星 = get_node(植物卡路径 +str(i+1)+ "/植物属性/植物升星")
	var 植物精通 = get_node(植物卡路径 +str(i+1)+ "/植物属性/植物精通")
	var 植物碎片 = get_node(植物卡路径 +str(i+1)+ "/植物属性/碎片数量")
	var 获得植物碎片 = get_node(植物卡路径 +str(i+1)+ "/碎片数量")
	var 当前植物数据 = 全局放置.获取或新建植物(str(植物奖励))
	var 升星解锁费用 = 10
	var 植物升星等级 = min(int(当前植物数据.get("升星等级")),3)
	if 当前植物数据.get("解锁"):
		植物解锁按钮文本.text = "升星"
		var 升星等级 = 当前植物数据.get("升星等级", 0.0)  # 获取浮点类型的升星等级，默认0.0
		升星解锁费用 += int((升星等级 + 1) * 5)
		print(升星解锁费用)
	else:
		植物解锁按钮文本.text = "解锁"
	植物名称.text = str(植物奖励)
	
	
	植物升星.text = "★".repeat(植物升星等级) + "☆".repeat(3-植物升星等级)
	var 精通等级 = int(当前植物数据.get("精通等级", 0))  # 获取并转换精通等级
	var 当前精通值 = int(当前植物数据.get("精通", 0))    # 获取并转换当前精通值
	var 升级需求 = 全局放置.计算植物升级需求(精通等级)   # 计算升级需求
# 拼接文本
	植物精通.text = "精通等级：" + str(精通等级) + "/"+ str(int((max(精通等级,1)+19)/20)*20) +"\r精通：" + str(当前精通值) + "/" + str(升级需求) +"\r升级进度" + str(int(当前精通值*1.0/升级需求*100)) + "%"
	植物碎片.text = "碎片："+str(int(当前植物数据.get("植物碎片")))+"/"+str(升星解锁费用)
	获得植物碎片.text = "+"+str(奖池.get(str(植物奖励)))
	#print(str(植物卡路径+str(i+1)))
	植物卡路径 =get_node(植物卡路径+str(i+1))
	植物卡路径.visible = true
	实例化植物(植物场景容器, Global.PlantTypeSceneMap[全局放置.获取植物枚举(植物奖励)])
	

func 加载植物简介(植物奖励):
	实例化植物($"植物/植物场景",Global.PlantTypeSceneMap[全局放置.获取植物枚举(植物奖励)])
	# 假设 "植物奖励" 是存储键名的变量
	var 缓存简介 = 全局放置.植物图鉴字典[植物奖励]
	var 简介地址 = $"植物/植物简介"
	var 名称地址 = $"植物/植物名称"
	#print(缓存简介)
	var 显示简介 = 缓存简介["描述"]#+str("\r")+缓存简介["描述"]+str("\r")+缓存简介["简介"]
	简介地址.text = 显示简介
	名称地址.text = 植物奖励

func 实例化植物(植物场景,植物路径):
	if 植物场景:
		# 遍历并移除所有子节点
		for 子节点 in 植物场景.get_children():
			子节点.queue_free()# 使用queue_free()安全移除节点
				
	# 加载并实例化植物场景下
	if 植物路径:
		var 植物 = 植物路径.instantiate()
		# 可选：如果需要禁用植物场景的脚本
		植物.script = null
		# 将植物实例添加到"植物/植物场景"下
		植物场景.add_child(植物)

# 核心逻辑：抽取植物碎片奖励
func 抽取植物碎片奖励():
# 清空奖池（每次抽取前重置，避免累计）
	奖池.clear()

# 3. 处理首通奖励（如果首通）
	if 首通奖励 and 关卡奖励卡池.size() > 0:
# 从关卡卡池中随机选1种植物
		var 首通植物 = 关卡奖励卡池[randi() % 关卡奖励卡池.size()]
# 加入奖池，碎片数为10
		奖池[首通植物] = 10
		print("首通奖励：",首通植物,"×10")

# 4. 处理碎片奖励抽取（按次数抽取）
	for i in range(碎片奖励次数):
# 检查奖池是否已达3种植物
		if 奖池.size() < 3:
# 奖池未满：可从关卡卡池随机抽新植物
			var 随机植物 = 关卡奖励卡池[randi() % 关卡奖励卡池.size()]
# 如果植物已在奖池，增加碎片；否则新增植物（碎片数1）
			if 随机植物 in 奖池:
				奖池[随机植物] += 1
			else:
				奖池[随机植物] = 1
			print("第",i+1,"次抽取（新增）：",随机植物," ×1")
		else:
# 奖池已满：只能从现有植物中增加碎片
			var 现有植物列表 = 奖池.keys()  # 获取奖池中已有的植物
			var 随机植物 = 现有植物列表[randi() % 现有植物列表.size()]
			奖池[随机植物] += 1
			print("第",i+1,"次抽取（追加）：",随机植物," ×1")


func _解锁植物或升星(argument_1) -> void:
	var 尝试解锁升星的植物=奖池.keys()[argument_1]
	print("尝试解锁 ",尝试解锁升星的植物," 植物")
	全局放置.解锁植物(str(尝试解锁升星的植物))
	全局放置.覆盖当前植物(全局放置.解锁植物数组())
	更新奖励(argument_1)
	pass # Replace with function body.


func _更新显示植物(argument_1) -> void:
	var 植物奖励 = 奖池.keys()[argument_1]
	加载植物简介(植物奖励)
	pass # Replace with function body.


