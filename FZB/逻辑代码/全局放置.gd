func 覆盖当前植物(中文植物名称数组: Array):
	var 枚举值数组 = []
	
	# 遍历中文名称数组,转换为枚举值
	for 中文名称 in 中文植物名称数组:
		var 英文名称 = 植物中文名字典.get(中文名称, null)
		if 英文名称:
			# 通过反射获取枚举值（假设 PlantType 是全局枚举）
			var 枚举值 = Global.PlantType.get(英文名称, null)
			if 枚举值 != null:
				枚举值数组.append(枚举值)
			else:
				print("警告: 未找到植物类型对应的枚举值:", 英文名称)
		else:
			print("警告: 未知植物名称:", 中文名称)
	Global.curr_plant = 枚举值数组
	return 枚举值数组

