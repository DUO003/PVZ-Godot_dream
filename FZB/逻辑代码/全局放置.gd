#region 文件加载
# 从文件加载存档
func 加载存档() -> bool:
	var file = FileAccess.open(存档地址, FileAccess.READ)

	if file != null:
		var json_string = file.get_as_text()
		var json = JSON.new()
		var parse_result = json.parse(json_string)
		if parse_result == OK:
			放置版存档 = json.get_data()
			
			# 新增:检查并初始化键（兼容旧存档）
			var 存档修复次数 = 0
			if "植物数据" not in 放置版存档:
				放置版存档["植物数据"] = {}  # 创建空的植物数据字典
				存档修复次数+=1
				print("存档修复:添加植物数据")
			if "物品" not in 放置版存档:
				放置版存档["物品"] = {}  # 创建空的物品字典
				存档修复次数+=1
				print("存档修复:添加物品")
			if "关卡" not in 放置版存档:
				放置版存档["关卡"] = {}  # 创建空的关卡字典
				存档修复次数+=1
				print("存档修复:添加关卡")
			file.close()
			if 存档修复次数 != 0:
				保存存档()
				print("检测到存档损坏,已修复并保存.
存档修复次数:",存档修复次数)
			print("存档加载成功")
			return true
		else:
			print("JSON解析错误")
		file.close()

	print("存档文件不存在或加载失败,创建新存档")
	保存存档()
	return false
	
# 保存存档到文件
func 保存存档() -> bool:
	var file = FileAccess.open(存档地址, FileAccess.WRITE)
	
	if file != null:
		# 将存档数据转换为JSON字符串（关键修复:print() 改为 stringify()）
		var json = JSON.new()
		var json_string = json.stringify(放置版存档)  # 这里是修复的地方
		file.store_string(json_string)
		file.close()
		print("存档保存成功")
		return true
	else:
		print("无法保存存档文件")
		return false
#endregion

#region 植物方法
# ========== 植物数据管理方法 ==========

# 获取所有植物数据
func 获取所有植物数据() -> Array:
	return 放置版存档["植物数据"]

# 根据名称查找植物数据
func 获取存档植物(植物: String) -> Dictionary:
	for plant in 放置版存档["植物数据"]:
		if plant["名称"] == 植物:
			return plant
	return {}  # 返回空字典而不是null

# 添加新植物
func 获取或新建植物(植物: String) -> Dictionary:
	# 检查植物是否已存在
	var 老植物=获取存档植物(植物)
	if  老植物!= {}:  # 修复:之前判断null,现在应为空字典
		#print("植物已存在:", 植物)
		return 老植物
	# 添加新植物
	var 新植物 = {
		"名称": 植物,
		"解锁": false,
		"植物碎片": 0,
		"升星等级": 0,
		"精通等级": 0,
		"精通": 0
	}
	放置版存档["植物数据"].append(新植物)
	保存存档()  # 保存更改
	return 新植物

# 解锁植物
func 解锁植物(植物: String) -> bool:
	var 植物数据 = 获取或新建植物(植物)
	if 植物数据 != {} and !植物数据["解锁"]:  # 修复:判断空字典而非null
		植物数据["解锁"] = true
		放置版存档["植物数据"][植物索引(植物)]=植物数据
		保存存档()
		return true
	return false

# 增加植物碎片
func 增加植物碎片(植物: String, 数量: int) -> bool:
	var 植物数据 = 获取或新建植物(植物)
	if 植物数据 != {}:  # 修复:判断空字典而非null
		植物数据["植物碎片"] += 数量
		放置版存档["植物数据"][植物索引(植物)]=植物数据
		保存存档()
		return true
	return false

func 解锁植物数组() -> Array:
	var 缓存植物数组 = []
	var 读取植物数组 = 获取所有植物数据()
	# 遍历植物数据列表
	for 植物 in 读取植物数组:
		# 检查植物是否已解锁
		if 植物.get("解锁", false):  # 使用 get 方法确保键存在,默认为 false
			缓存植物数组.append(植物.get("名称", ""))  # 添加已解锁植物的名称
	return 缓存植物数组

func 计算植物升级需求(植物精通等级:int, 卡牌类型:String = "白卡") -> int:
	var 卡片类型倍率 = {
		"白卡": 0.0,
		"金卡": 1.0,
		"钻卡": 1.5,
		"星卡": 4.0,
		"彩卡": 2.0
	}.get(卡牌类型, 0.0)
	
	if 植物精通等级 == 100 or 植物精通等级 < 0 or 植物精通等级 > 100:
		push_warning("植物精通等级必须在0-99范围内")
		return -1
	
	var 阶段 = floor(植物精通等级 / 20)
	var 影响倍率 = 0.75 **阶段
	
	var 额外增加数值 = 7.5 * (40 if 植物精通等级 > 40 else 植物精通等级)
	
	var 成长倍率 = 1.033
	var 基础值 = 20 * (成长倍率** 植物精通等级) + 额外增加数值
	
	var 最终值 = 基础值 * (1 + 影响倍率 * 卡片类型倍率)
	
	return round(最终值)

func 调试植物升级数值及总计():
	var 白卡总需求 = 0
	var 金卡总需求 = 0
	var 钻卡总需求 = 0
	var 星卡总需求 = 0
	var 彩卡总需求 = 0
	
	print("等级 : 白卡需求 : 金卡需求 : 钻卡数值 : 星卡需求 : 彩卡需求")
	print("---------------------------------------------------------")
	
	for 等级 in range(0, 100):
		var 白卡数值 = 计算植物升级需求(等级, "白卡")
		var 金卡数值 = 计算植物升级需求(等级, "金卡")
		var 钻卡数值 = 计算植物升级需求(等级, "钻卡")
		var 星卡数值 = 计算植物升级需求(等级, "星卡")
		var 彩卡数值 = 计算植物升级需求(等级, "彩卡")
		
		if 白卡数值 > 0:
			白卡总需求 += 白卡数值
			金卡总需求 += 金卡数值
			钻卡总需求 += 钻卡数值
			星卡总需求 += 星卡数值
			彩卡总需求 += 彩卡数值
		
		print("%d : %d : %d : %d : %d : %d" % [等级, 白卡数值, 金卡数值, 钻卡数值, 星卡数值, 彩卡数值])
	
	print("\n---------------------------------------------------------")
	
	var 金卡百分比 = (金卡总需求* 1.0 / 白卡总需求) * 100
	var 钻卡百分比 = (钻卡总需求* 1.0 / 白卡总需求) * 100
	var 星卡百分比 = (星卡总需求* 1.0 / 白卡总需求) * 100
	var 彩卡百分比 = (彩卡总需求* 1.0 / 白卡总需求) * 100
	
	print("白卡 总需求: %d, 100%%" % 白卡总需求)
	print("金卡 总需求: %d, %.2f%%" % [金卡总需求, 金卡百分比])
	print("钻卡 总需求: %d, %.2f%%" % [钻卡总需求, 钻卡百分比])
	print("星卡 总需求: %d, %.2f%%" % [星卡总需求, 星卡百分比])
	print("彩卡 总需求: %d, %.2f%%" % [彩卡总需求, 彩卡百分比])

func 精通结算升级(植物: String, 突破:bool = false):
	var 植物数据 = 获取存档植物(植物)
	
	if 植物数据 == {} or 植物数据.size() == 0:
		print("未找到植物存档数据：", 植物)
		return
	
	var 当前精通等级 = int(植物数据.get("精通等级", 0))
	var 当前精通值 = int(植物数据.get("精通", 0))
	var 卡片类型 = "白卡"
	
	while true:
		if 当前精通等级 % 20 == 0 and 当前精通等级 != 0 and not 突破:
			break
		else:
			if 当前精通等级 % 20 == 0:
				突破 = false
		
		var 需求精通值 = 计算植物升级需求(当前精通等级, 卡片类型)
		
		if 需求精通值 > 0 and 当前精通值 >= 需求精通值:
			当前精通等级 += 1
			当前精通值 -= 需求精通值
		else:
			break
	
	#print("植物：", 植物)
	#print("升级后等级：", 当前精通等级)
	#print("剩余精通值：", 当前精通值)
	if 植物数据 != {}:  # 修复:判断空字典而非null
		植物数据["精通等级"] = 当前精通等级
		植物数据["精通"] = 当前精通值
		放置版存档["植物数据"][植物索引(植物)]=植物数据
		保存存档()

func 植物索引(植物名称: String) -> int:
	var 植物数组 = 放置版存档["植物数据"]
# 遍历植物数组查找目标植物
	for i in range(植物数组.size()):
		var 植物数据 = 植物数组[i]
# 检查当前元素是否包含"名称"字段且匹配目标植物
		if 植物数据.has("名称") and 植物数据["名称"] == 植物名称:
			return i  # 找到返回索引
	return -1  # 未找到返回-1


