# 处理通关记录的函数
func 处理通关记录():
	# 从枚举值获取关卡名称
	var 当前关卡名称 = 关卡名称映射.get(选中关卡, null)
	
	# 检查是否获取到有效的关卡名称
	if 当前关卡名称 == null:
		print("错误：未找到对应的关卡名称，枚举值:", 选中关卡)
		return
	
	# 检查关卡数据是否存在，如果不存在则创建
	if 当前关卡名称 not in 放置版存档["关卡"]:
		# 创建新关卡的默认数据
		放置版存档["关卡"][当前关卡名称] = {
			"通关次数": 0,
			"最高评分": 0,
			"奖杯": [],
			"自动种植方案A": {
				"植物方阵": [],
				"种植策略": []
			}
		}
		print("创建新关卡记录: ", 当前关卡名称)
	
	# 将通关次数加1
	if int(放置版存档["关卡"][当前关卡名称]["通关次数"]) == 0:
		print("首通")
		首通奖励 = true
	else:
		首通奖励 = false
	放置版存档["关卡"][当前关卡名称]["通关次数"] += 1
	print("关卡 ", 当前关卡名称, " 通关次数更新为: ", 放置版存档["关卡"][当前关卡名称]["通关次数"])
	保存存档()


